<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog מגדיר כאן רק *לאן* ובאיזה *פורמט* לכתוב.
  *אילו רמות* נכתבות נקבע ב-appsettings (סעיף Logging) — מקור אחד לכל סביבה.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- CorrelationId מגיע מה-scope שה-middleware פותח לכל בקשה; מחוץ לבקשה יופיע "-". -->
  <variable name="lineLayout"
            value="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:CorrelationId:whenEmpty=-} | ${logger:shortName=true} | ${message}${onexception:${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${lineLayout}" />

    <!-- קובץ חדש לכל יום, שמירה של 14 ימים אחרונים. -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/chugim-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8"
            maxArchiveFiles="14" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="console,file" />
  </rules>
</nlog>
